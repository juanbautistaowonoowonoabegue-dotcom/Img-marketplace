rules_version = '2';

// Reglas de Firestore — Compra Ya
//
// Principios:
//  1. Sin comodin final. Toda coleccion no declarada aqui queda denegada.
//  2. El rol vive en custom claims de Auth (request.auth.token.role), nunca en un
//     documento que el propio usuario pueda editar.
//  3. Las reglas de lectura publica estan alineadas con las consultas que el cliente
//     ejecuta hoy: una condicion sobre resource.data en un `list` obliga a que la
//     consulta lleve el filtro equivalente, y varios listados actuales no lo llevan.
//
// Requisito previo al despliegue: ejecutar `node scripts/set-role.mjs <uid> superadmin`
// para el administrador. Sin el claim, nadie tendra acceso administrativo.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identidad ───────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'superadmin';
    }

    function isOwner(ownerId) {
      return isSignedIn() && uid() == ownerId;
    }

    // Campos modificados por esta escritura.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Usuarios ────────────────────────────────────────────────────────────
    // El codigo cliente usa dos colecciones para la misma entidad: `usuarios`
    // (27 referencias) y `users` (auth-guard, ai-guard). Ambas quedan cubiertas
    // hasta que se unifiquen. Ver docs/AUDITORIA.md, P0-4.
    //
    // `get` publico: las fichas de vendedor y de producto se ven sin sesion y
    // resuelven el nombre del vendedor. `list` restringido: evita el volcado
    // masivo de correos y telefonos.
    //
    // Campos reservados a administracion: banned, premium, isVerified, verifiedAt,
    // verifiedNote, rol. El resto lo edita el propio usuario.
    function selfEditableUserFields() {
      return [
        'nombre', 'nombreBusca', 'displayName', 'email', 'telefono', 'bio',
        'photoURL', 'direccion', 'ciudad', 'barrio', 'ultimaVez', 'updatedAt',
        'fcmToken', 'fcmTokens', 'preferencias', 'premiumModalSeen',
        'aiCallsCount', 'isPremium', 'premiumExpiry', 'premiumActivadoEn', 'role'
      ];
    }

    match /usuarios/{userId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isAdmin()
                    || (isOwner(userId) && changed().hasOnly(selfEditableUserFields()));
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isAdmin()
                    || (isOwner(userId) && changed().hasOnly(selfEditableUserFields()));
      allow delete: if isAdmin();
    }

    // ── Catalogo ────────────────────────────────────────────────────────────
    // Lectura publica sin condicion: los listados actuales consultan sin filtrar
    // por estado (`limit(20)`, `where('vendido','==',false)`), y una condicion
    // sobre resource.data haria fallar la consulta entera.
    //
    // El contador de visitas lo incrementa cualquier visitante, asi que se admite
    // esa escritura acotada a un unico campo.
    function isSellerOwner() {
      return isSignedIn() && resource.data.vendedorId == uid();
    }

    function onlyVisitCounter() {
      return changed().hasOnly(['visitas']);
    }

    match /productos/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.vendedorId == uid();
      allow update: if isAdmin() || isSellerOwner() || onlyVisitCounter();
      allow delete: if isAdmin() || isSellerOwner();
    }

    // Duplicado historico de `productos`, aun en uso (13 referencias).
    match /Producto/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.vendedorId == uid();
      allow update: if isAdmin() || isSellerOwner() || onlyVisitCounter();
      allow delete: if isAdmin() || isSellerOwner();
    }

    match /servicios/{serviceId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.vendedorId == uid();
      allow update: if isAdmin() || isSellerOwner() || onlyVisitCounter();
      allow delete: if isAdmin() || isSellerOwner();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }

      match /changelog/{entryId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    match /resenas/{resenaId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Mensajeria ──────────────────────────────────────────────────────────
    function isChatMember(chatId) {
      return isSignedIn()
             && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && uid() in resource.data.participantes;
      allow create: if isSignedIn() && uid() in request.resource.data.participantes;
      allow update: if isSignedIn() && uid() in resource.data.participantes;
      allow delete: if isAdmin();

      match /mensajes/{mensajeId} {
        allow read, create: if isChatMember(chatId);
        allow update, delete: if isAdmin();
      }
    }

    function isCommunityMember(commId) {
      return isSignedIn()
             && uid() in get(/databases/$(database)/documents/comunidades/$(commId)).data.miembros;
    }

    match /comunidades/{commId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && uid() in request.resource.data.miembros;
      // Entrar y salir de una comunidad solo toca `miembros`.
      allow update: if isAdmin()
                    || (isSignedIn() && uid() in resource.data.miembros)
                    || (isSignedIn() && changed().hasOnly(['miembros']));
      allow delete: if isAdmin();

      match /mensajes/{mensajeId} {
        allow read, create: if isCommunityMember(commId);
        allow update, delete: if isAdmin();
      }
    }

    // Historial de conversaciones con el asistente, particionado por usuario.
    match /ai_chats/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      match /mensajes/{mensajeId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ── Comercio ────────────────────────────────────────────────────────────
    match /carritos/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // `read` cubre get y list. En un `list`, Firestore evalua la regla contra
    // cada documento candidato: una consulta sin `where('compradorId','==',uid)`
    // falla entera, que es justo lo que se quiere.
    match /pedidos/{pedidoId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.compradorId == uid());
      allow create: if isSignedIn() && request.resource.data.compradorId == uid();
      allow update: if isAdmin() || (isSignedIn() && resource.data.compradorId == uid());
      allow delete: if isAdmin();
    }

    // Los pagos no se releen desde el cliente: solo se crean y los revisa
    // administracion. Sin lectura para el comprador.
    match /pagos/{pagoId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /transacciones/{txId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /reservas/{reservaId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow delete: if isAdmin();
    }

    match /delivery/{deliveryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Los codigos se canjean leyendolos por su identificador y marcandolos usados.
    // `get` con sesion, pero `list` solo administracion: de lo contrario
    // cualquiera podria enumerar los codigos sin usar y canjearlos.
    match /codigosPremium/{codigoId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow update: if isAdmin()
                    || (isSignedIn() && changed().hasOnly(['usado', 'usadoPor', 'usadoEn']));
      allow create, delete: if isAdmin();
    }

    // ── Notificaciones y social ─────────────────────────────────────────────
    match /notificaciones/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.para == uid());
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.para == uid());
      allow delete: if isAdmin();
    }

    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Identificador compuesto: <seguidorUid>_<seguidoUid>.
    match /seguidores/{relacionId} {
      allow read: if true;
      allow create, delete: if isSignedIn() && relacionId.split('_')[0] == uid();
      allow update: if isAdmin();
    }

    match /likes/{likeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /presencia/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // ── Correo saliente (extension Trigger Email) ───────────────────────────
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /emailQueue/{itemId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /email_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // ── Administracion y telemetria ─────────────────────────────────────────
    // system_config guarda claves de API: solo administracion.
    match /system_config/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // config/admin lo lee una pagina publica. No debe contener secretos.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reportes/{reporteId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /cy_analytics/{userId} {
      allow read: if isAdmin();
      allow write: if isOwner(userId);

      match /eventos/{eventoId} {
        allow read: if isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();
      }
    }

    match /cy_dashboard_live/{docId} {
      allow read, write: if isAdmin();
    }

    // Sin comodin final: lo no declarado queda denegado.
  }
}
