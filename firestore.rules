rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isSignedIn() && userDoc().data.role == 'superadmin';
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    match /system_config/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isOwner(uid) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /servicios/{serviceId} {
      allow read: if resource.data.status == 'activo'
                  || (isSignedIn() && (
                    resource.data.vendedorId == request.auth.uid || isSuperAdmin()
                  ));
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.vendedorId == request.auth.uid || isSuperAdmin()
      );
    }

    match /servicios/{serviceId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /servicios/{serviceId}/changelog/{entryId} {
      allow read, write: if isSignedIn();
    }

    match /productos/{productId} {
      allow read: if resource.data.status == 'activo'
                  || (isSignedIn() && (
                    resource.data.vendedorId == request.auth.uid || isSuperAdmin()
                  ));
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.vendedorId == request.auth.uid || isSuperAdmin()
      );
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /notificaciones/{notifId} {
      allow read, update: if isSignedIn() && resource.data.para == request.auth.uid;
      allow create: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    match /pedidos/{pedidoId} {
      allow read: if isSignedIn() && (
        resource.data.compradorId == request.auth.uid
        || resource.data.vendedorId == request.auth.uid
        || isSuperAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.compradorId == request.auth.uid
        || resource.data.vendedorId == request.auth.uid
        || isSuperAdmin()
      );
    }

    match /delivery/{deliveryId} {
      allow read, write: if isSignedIn();
    }

    match /transacciones/{txId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin();
    }

    match /reservas/{reservaId} {
      allow read, create, update: if isSignedIn();
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
