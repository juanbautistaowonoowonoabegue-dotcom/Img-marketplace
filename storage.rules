rules_version = '2';

// Reglas de Storage — Compra Ya
//
// Las reglas anteriores solo declaraban public/, users/, servicios/ y banners/,
// mientras el cliente sube a perfiles/, productos/, anuncios/, mensajes/ y
// comunidades/. Storage deniega por defecto, asi que esas subidas no estaban
// contempladas. Aqui se declaran todas las rutas reales con limite de tamano y
// de tipo de contenido.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'superadmin';
    }

    // 5 MB e imagen. Cubre las fotos que el cliente ya reduce a WebP.
    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    // Borrar es reemplazar por nada: request.resource es null.
    function isDelete() {
      return request.resource == null;
    }

    // Foto de perfil: cada usuario la suya.
    match /perfiles/{userId} {
      allow read: if true;
      allow write: if (isSignedIn() && request.auth.uid == userId && isImageUnder5MB())
                   || isAdmin();
    }

    // Imagenes de producto, particionadas por vendedor.
    match /productos/{userId}/{fileName} {
      allow read: if true;
      allow write: if (isSignedIn() && request.auth.uid == userId
                       && (isImageUnder5MB() || isDelete()))
                   || isAdmin();
    }

    // Imagenes y logotipo de servicio. La propiedad del servicio vive en
    // Firestore y Storage no puede consultarla: se exige sesion y formato.
    match /servicios/{servicioId}/{fileName} {
      allow read: if true;
      allow write: if (isSignedIn() && (isImageUnder5MB() || isDelete())) || isAdmin();
    }

    // Adjuntos de chat y de comunidad.
    match /mensajes/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImageUnder5MB();
    }

    match /anuncios/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImageUnder5MB();
    }

    match /comunidades/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImageUnder5MB();
    }

    // Banners de portada: solo administracion.
    match /banners/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && (isImageUnder5MB() || isDelete());
    }

    // Ruta heredada. Se conserva la lectura publica; la escritura pasa a
    // administracion para cerrar la subida libre de ficheros arbitrarios.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isSignedIn() && request.auth.uid == userId
                       && (isImageUnder5MB() || isDelete()))
                   || isAdmin();
    }

    // Sin comodin final: lo no declarado queda denegado.
  }
}
